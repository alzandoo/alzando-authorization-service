APP_ENV=development
# Development only: allow X-Dev-Application-Id to impersonate an application (ignored outside development).
ALLOW_DEV_IDENTITY_HEADER=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_IP_PER_MINUTE=120
RATE_LIMIT_IDENTIFIER_ATTEMPTS=10
RATE_LIMIT_IDENTIFIER_WINDOW_SECONDS=900
# Set true only behind a trusted reverse proxy that appends X-Forwarded-For.
TRUST_PROXY_HEADERS=false
VERIFICATION_RESEND_INTERVAL_SECONDS=60
DATABASE_URL=postgresql+psycopg://alzando:alzando_dev@localhost:5432/alzando_authz
CHALLENGE_HMAC_SECRET=
PASSWORD_RECOVERY_TTL_SECONDS=300
PASSWORD_RECOVERY_RESEND_INTERVAL_SECONDS=60
EMAIL_VERIFICATION_TTL_SECONDS=600
PHONE_VERIFICATION_TTL_SECONDS=600
OTP_TTL_SECONDS=300
OTP_RESEND_INTERVAL_SECONDS=60
ACCESS_TOKEN_TTL_SECONDS=300
REFRESH_TOKEN_TTL_SECONDS=2592000
AUTHENTICATION_GRANT_TTL_SECONDS=300
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_STARTTLS=true
